# ==============================================================================
# VOLONCE AI BILLING - 1-CLICK ENVIRONMENT CONFIGURATION (.env.example)
# આ ફાઈલને .env તરીકે કોપી કરો: cp .env.example .env
# ==============================================================================

# ---------------- ૧. DATABASE CONFIGURATION (POSTGRESQL 16) ----------------
POSTGRES_USER=volonce_user
POSTGRES_PASSWORD=volonce_secret_pass_2026
POSTGRES_DB=volonce_billing
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# (નોંધ: Docker Compose માં આ આપોઆપ 'postgres' સર્વિસ સાથે કનેક્ટ થશે)

# ---------------- ૨. CACHE & BACKGROUND TASK QUEUE (REDIS 7) ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# (નોંધ: Docker Compose માં આ આપોઆપ 'redis' સર્વિસ સાથે કનેક્ટ થશે)

# ---------------- ૩. AUTHENTICATION & SECURITY (JWT TOKENS) ----------------
# સુરક્ષિત રેન્ડમ ૬૪-અક્ષરની કી વાપરો (openssl rand -hex 32)
JWT_SECRET_KEY=volonce_super_jwt_secret_key_production_2026_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---------------- ૪. AI VISION & OBJECT DETECTION (GOOGLE GEMINI) ----------------
# Google AI Studio માંથી મેળવેલી API Key (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere12345

# ---------------- ૫. META WHATSAPP CLOUD API (OFFICIAL BUSINESS) ----------------
# Meta Developers Portal (https://developers.facebook.com/)
WHATSAPP_API_TOKEN=EAAG...YourMetaPermanentSystemUserToken
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_WABA_ID=200000000000000
WHATSAPP_VERIFY_TOKEN=volonce_wa_verify_2026

# ---------------- ૬. PAYMENT GATEWAY (RAZORPAY SUBSCRIPTIONS) ----------------
# Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_TsaJVIkvM3i9jj
RAZORPAY_KEY_SECRET=nqoEGJZxurIYyUzF7kUpFRuZ

# ---------------- ૭. EXTERNAL WEBSITE WEBHOOK (volonis.in INTEGRATION) --------
# volonis.in પરથી ખરીદી થાય ત્યારે સબસ્ક્રિપ્શન ઓટો-એક્ટિવેટ કરવા માટે
VOLONIS_WEBHOOK_SECRET=volonis_super_secure_secret_key_2026

# ---------------- ૮. FILE & PDF STORAGE (LOCAL OR S3/CLOUDFLARE R2) ----------
# વિકલ્પો: "local" (ડેવલપમેન્ટ માટે) અથવા "s3" (પ્રોડક્શન માટે)
STORAGE_BACKEND=local

# જો STORAGE_BACKEND=s3 પસંદ કરો તો નીચેની વિગતો ભરો:
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=volonce-storage
S3_REGION_NAME=auto

# ---------------- ૯. WEB FRONTEND & MOBILE API URLs --------------------------
# Next.js વેબ એપ માટે બેકએન્ડ API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# React Native Expo મોબાઇલ એપ માટે (તમારા લેપટોપનું LAN IP વાપરો, જેમ કે 192.168.1.X)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000