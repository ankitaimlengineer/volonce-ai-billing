{
  "expo": {
    "name": "Volonce Billing",
    "slug": "volonce-ai-billing",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "volonce",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.volonce.billing",
      "infoPlist": {
        "NSCameraUsageDescription": "પ્રોડક્ટ બારકોડ સ્કેન કરવા અને AI કેમેરા બિલિંગ માટે કેમેરાની પરવાનગી જરૂરી છે.",
        "NSPhotoLibraryUsageDescription": "પ્રોડક્ટ અને બિલના ફોટા પસંદ કરવા માટે ફોટો ગેલેરીની પરવાનગી આપો."
      }
    },
    "android": {
      "package": "com.volonce.billing",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "પ્રોડક્ટ બારકોડ સ્કેન કરવા માટે કેમેરાની પરવાનગી આપો."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "પ્રોડક્ટના ફોટા પસંદ કરવા માટે ફોટો ગેલેરીની પરવાનગી આપો."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "026cbcfe-6b6e-44da-8390-fd99d5c0b0bc"
      }
    }
  }
}
